# Repo-root env for scripts that run from the monorepo root (currently just
# scripts/db-reset.sh). Copy to .env (`cp .env.example .env`) — it's
# gitignored. Unlike the per-service .env files under services/*/, this one
# only holds operator-specific values, never service config.

# Your own Clerk user id (Clerk dashboard → Users, or the JWT `sub` claim
# after signing in through the SPA once). `make db:reset` bootstraps this
# identity as admin and — the first time it's created — enrolls it in a
# course and assigns it a standalone path, so your real account survives a
# reset instead of having to be manually re-registered and re-progressed
# every time. Idempotent: a restored/pre-existing identity is left untouched.
ADMIN_CLERK_USER_ID=user_replace_me
