# Staging settings that are safe to keep in Git. Secrets and values owned by
# the infrastructure (connection strings, Clerk key, registry, bucket) come
# from SSM Parameter Store at deploy time; see deploy/README.md.

MOTIFPATH_ENV=staging
AWS_REGION=us-east-2
MONGO_DATABASE=motifpath_events

CORS_ALLOWED_ORIGINS=https://staging.motifpath.com
MEDIA_PUBLIC_BASE_URL=https://media.staging.motifpath.com

# Loopback ports the edge Caddy proxies to. Must match deploy/edge/Caddyfile
# and differ from production's.
CORE_DOMAIN_HOST_PORT=9080
EVENT_INGESTION_HOST_PORT=9081
ENGAGEMENT_MAILER_HOST_PORT=9083
AGGREGATION_WORKER_HOST_PORT=9082

# Smaller ceilings than production's, so a busy staging cannot take the
# memory or CPU production needs on the shared host.
REDPANDA_MEMORY=512M
REDPANDA_LIMIT=768M
REDPANDA_CPUS=0.5
CORE_DOMAIN_MEMORY=384M
CORE_DOMAIN_CPUS=0.5
EVENT_INGESTION_MEMORY=160M
EVENT_INGESTION_CPUS=0.5
AGGREGATION_WORKER_MEMORY=256M
AGGREGATION_WORKER_CPUS=0.5
ENGAGEMENT_MAILER_MEMORY=128M
ENGAGEMENT_MAILER_CPUS=0.25

# Where the engagement emails' links point: the app, and the API that takes
# their one-click unsubscribe.
APP_BASE_URL=https://staging.motifpath.com
API_BASE_URL=https://api.staging.motifpath.com
