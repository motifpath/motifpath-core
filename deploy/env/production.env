# Production settings that are safe to keep in Git. Secrets and values owned
# by the infrastructure (connection strings, Clerk key, registry, bucket) come
# from SSM Parameter Store at deploy time; see deploy/README.md.

MOTIFPATH_ENV=production
AWS_REGION=us-east-2
MONGO_DATABASE=motifpath_events

CORS_ALLOWED_ORIGINS=https://app.motifpath.com
MEDIA_PUBLIC_BASE_URL=https://media.motifpath.com

# Loopback ports the edge Caddy proxies to. Must match deploy/edge/Caddyfile
# and differ from staging's.
CORE_DOMAIN_HOST_PORT=8080
EVENT_INGESTION_HOST_PORT=8081
AGGREGATION_WORKER_HOST_PORT=8082

# Ceilings, not reservations, on a 2 vCPU / 4 GiB host shared with staging.
REDPANDA_MEMORY=768M
REDPANDA_LIMIT=1024M
REDPANDA_CPUS=1.0
CORE_DOMAIN_MEMORY=640M
CORE_DOMAIN_CPUS=1.5
EVENT_INGESTION_MEMORY=256M
EVENT_INGESTION_CPUS=1.0
AGGREGATION_WORKER_MEMORY=384M
AGGREGATION_WORKER_CPUS=1.0
