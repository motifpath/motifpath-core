# event-ingestion service — copy to .env for local dev (`cp .env.example .env`).
# .env is gitignored. Keys and their owners are the canonical contract in
# ADR-016 §5; values below target the docker-compose dependency stack
# (`make dev`).

# HTTP listen port. core-domain = 8080, event-ingestion = 8081,
# aggregation-worker = 8082.
PORT=8081

# MongoDB connection string for the events collection (raw tracking log).
MONGO_URI=mongodb://motifpath:motifpath@localhost:27017/?authSource=admin

# MongoDB database name. Defaults to motifpath_events if unset.
MONGO_DATABASE=motifpath_events

# Comma-separated Kafka bootstrap brokers. Local Redpanda from docker-compose.
KAFKA_BROKERS=localhost:9092

# Clerk secret key — the same Clerk instance the SPA and core-domain use.
CLERK_SECRET_KEY=sk_test_replace_me

# Base URL of core-domain. Required: POST /events resolves the caller's
# MotifPath identity and role by calling core-domain (ADR-013/ADR-014).
CORE_DOMAIN_BASE_URL=http://localhost:8080

# Comma-separated browser origins allowed by CORS. Defaults to the Vite dev
# server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
