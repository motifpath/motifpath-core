# core-domain service — copy to .env for local dev (`cp .env.example .env`).
# .env is gitignored. Keys and their owners are the canonical contract in
# ADR-016 §5; values below target the docker-compose dependency stack
# (`make dev`).

# HTTP listen port. core-domain = 8080, event-ingestion = 8081,
# aggregation-worker = 8082.
PORT=8080

# Postgres DSN for the learning-graph store. Matches docker-compose.yml
# (user/pass motifpath, database core_domain). atlas migrate apply runs
# against this on startup (ADR-005).
DATABASE_URL=postgres://motifpath:motifpath@localhost:5432/core_domain?sslmode=disable

# MongoDB connection string for the completion-state store (the aggregates
# collection the Aggregation Worker owns, ADR-011).
MONGO_URI=mongodb://motifpath:motifpath@localhost:27017/?authSource=admin

# MongoDB database name. Defaults to motifpath_events if unset.
MONGO_DATABASE=motifpath_events

# Clerk secret key — the same Clerk instance the SPA uses (Clerk dashboard →
# API keys). Any non-empty value lets the service boot; a real sk_test_ key
# is needed to actually validate a token.
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated browser origins allowed by CORS. Defaults to the Vite dev
# server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
